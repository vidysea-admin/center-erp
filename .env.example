# Example environment for the Center ERP app. NAMES AND SHAPES ONLY — no real values, ever.
# Created 2026-09-14 for QA-2644: scripts/e2e-proxy.mjs has asserted since it was written that this
# file documents AUTH_URL, and the file did not exist, so that assertion crashed the suite instead
# of failing it. The suite is the repo's own record that this file is supposed to exist.

# --- Identity and origin -------------------------------------------------------------------
# AUTH_URL is the PUBLIC address the browser uses. Behind nginx the app sees an internal address
# (ip-10-0-...:3000), so any URL the SERVER builds from the request points somewhere no browser can
# reach - that is the 2026-08-12 sign-out bug, and scripts/e2e-proxy.mjs exists to reproduce it.
AUTH_URL=https://www.example.com/erp
APP_ORIGIN=https://www.example.com
AUTH_SECRET=

# --- Database ------------------------------------------------------------------------------
# Tests run against center_erp_ci*, NEVER center_erp. mailer.ts suppresses all mail unless
# MONGODB_DB is exactly "center_erp", so this name is a safety boundary and not just a pointer.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=center_erp_ci

# --- Off-switches used by CI and local walls (see .github/workflows/ci.yml, which is the source) --
STORAGE_DISABLE=1
MAIL_DISABLED=1
SMS_DISABLED=1
SMS_DAILY_CAP=6
SCHEDULER_DISABLED=1
SYNC_ALLOW_TEST_SOURCES=1

# --- Mail (Amazon SES) ----------------------------------------------------------------------
SES_SMTP_HOST=
SES_SMTP_PORT=
SES_SMTP_USER=
SES_SMTP_PASS=
SES_SNS_TOPIC_ARN=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# --- SMS (EnableX) --------------------------------------------------------------------------
ENABLEX_SMS_ENDPOINT=
ENABLEX_SMS_APP_ID=
ENABLEX_SMS_APP_KEY=
ENABLEX_SMS_SENDER_ID=
ENABLEX_SMS_CAMPAIGN_ID=

# --- Storage and sheets ---------------------------------------------------------------------
GS_PATH=
GDRIVE_ROOT_FOLDER_ID=
CLIENT_WORKBOOK_URL=
WATCH_SOURCE_URL=
